# NVIDIA CUDA image (matches the current dev box / cudaEnabled branch).
#
# Installs the CUDA torch wheel, then the package + extras. cuML/ThunderSVM are
# left out by default (heavy RAPIDS install); the classical layer detects them
# at runtime if you add them, otherwise falls back to sklearn. XGBoost GPU-hist
# works here (device='cuda').
ARG CUDA_TAG=12.4.1-cudnn-runtime-ubuntu22.04
FROM nvidia/cuda:${CUDA_TAG}

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHONPATH=/workspace/src

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        python3 python3-pip python3-venv build-essential git \
    && rm -rf /var/lib/apt/lists/* \
    && ln -sf /usr/bin/python3 /usr/bin/python

WORKDIR /workspace

# Torch CUDA build first (pin to your CUDA runtime; cu124 shown).
ARG TORCH_INDEX_URL=https://download.pytorch.org/whl/cu124
RUN python -m pip install --upgrade pip \
    && pip install torch --index-url ${TORCH_INDEX_URL}

COPY pyproject.toml requirements.txt ./
COPY src ./src
RUN pip install -e ".[faiss,gpu,stats]"

COPY . .

COPY docker/entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
CMD ["bash"]
